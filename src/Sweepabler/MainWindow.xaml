<Window x:Class="ProperAppUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ProperAppUpdater.Controls"
        mc:Ignorable="d"
        Title="Süpürücü"
        Icon="Assets/supurucu-polished.ico"
        Width="430"
        Height="340"
        MinWidth="430"
        MinHeight="340"
        MaxWidth="430"
        MaxHeight="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        </Style>

        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewPrimaryButton" TargetType="Button" BasedOn="{StaticResource PreviewButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootShell"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale"
                            ScaleX="0.97"
                            ScaleY="0.97" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderRow" Height="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <Grid Background="Transparent" Margin="0,0,14,0"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="BrandLogo" Source="Assets/supurucu-polished.png"
                           Width="42" Height="42" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel x:Name="HeaderText" Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AppNameText" Text="Süpürücü" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                            <TextBlock x:Name="ModeTitleText" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Bottom" Margin="9,0,0,3"
                                       Foreground="{DynamicResource AccentForegroundBrush}" />
                        </StackPanel>
                        <Grid Margin="0,1,0,0">
                            <TextBlock x:Name="StatusText" Text="Hazır." FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DeckStatusText" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Grid>
                <controls:DeckSwitcher x:Name="WorkspaceSwitcher" Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       SelectedDeckChanged="WorkspaceSwitcher_SelectedDeckChanged" />
            </Grid>

            <Grid x:Name="UpdateActions" Grid.Row="1" Margin="0,12,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="FindButton"
                        Content="Eskiyi bul"
                        Click="FindButton_Click" />
                <Button x:Name="SweepButton"
                        Grid.Column="2"
                        Content="Süpür!"
                        Style="{StaticResource PrimaryButton}"
                        Click="SweepButton_Click"
                        IsEnabled="False" />
            </Grid>

            <Grid x:Name="PreviewActions" Grid.Row="1" Margin="0,12,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviewFindButton" Style="{StaticResource PreviewButton}" />
                <Button x:Name="PreviewSweepButton" Grid.Column="2" Style="{StaticResource PreviewPrimaryButton}" />
            </Grid>

            <Border x:Name="UpdatePage" Grid.Row="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListBox x:Name="UpdatesList"
                         ItemsSource="{Binding Updates}"
                         BorderThickness="0" Padding="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12,10">
                                <Border x:Name="FamilyHeader"
                                        Background="{DynamicResource FamilyHeaderBrush}"
                                        BorderBrush="{DynamicResource FamilyBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="9,4"
                                        Margin="0,0,0,5"
                                        Visibility="Collapsed">
                                    <TextBlock Text="{Binding FamilyTitle}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FamilyForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <Border x:Name="CandidateRow"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="0,4">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{Binding PirateMenuText}"
                                                      Click="PirateCandidateMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="{Binding DeleteMenuText}"
                                                      Click="DeleteCandidateMenuItem_Click" />
                                            <MenuItem Header="{Binding FilePathMenuText}"
                                                      Click="FilePathCandidateMenuItem_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding UpdateAvailable}"
                                                  Click="CandidateCheckBox_Click" />

                                        <Border Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Background="#14000000"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding IconSource}"
                                                   Width="20"
                                                   Height="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding VersionLine, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourceLine, Mode=OneWay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="3"
                                                Background="{DynamicResource BadgeBackgroundBrush}"
                                                BorderBrush="{DynamicResource BadgeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,3"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BadgeForegroundBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowFamilyHeader}" Value="True">
                                    <Setter TargetName="FamilyHeader" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFamilyMember}" Value="True">
                                    <Setter TargetName="CandidateRow" Property="Background" Value="{DynamicResource FamilyBackgroundBrush}" />
                                    <Setter TargetName="CandidateRow" Property="BorderBrush" Value="{DynamicResource FamilyBorderBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="DevelopmentPage" Grid.Row="2" Visibility="Collapsed"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="DevelopmentBadgeText" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,0,0,3" />
                        <TextBlock x:Name="DeckTitleText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DeckDescriptionText" FontSize="11" LineHeight="15"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,6" />
                        <TextBlock x:Name="PlannedFeaturesText" FontSize="11" LineHeight="17"
                                   Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="FooterRow" Grid.Row="3" Margin="0,8,0,0">
                <Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="3"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                <TextBlock x:Name="FooterText" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="LanguageMenuItem" Click="LanguageMenuItem_Click"/>
                            <Separator/>
                            <MenuItem x:Name="ResetBlocksMenuItem" Click="ResetBlocksMenuItem_Click"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBlock x:Name="DevelopmentFooterText" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                           ContextMenu="{Binding ContextMenu, ElementName=FooterText}" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="PirateButton" Height="26" Padding="4,0" FontSize="10" Click="PirateButton_Click"/>
                    <Button x:Name="SelfSweepButton" Grid.Column="2" Height="26" Padding="4,0" FontSize="10" Click="SelfSweepButton_Click"/>
                    <Button x:Name="DeleteSelfButton" Grid.Column="4" Height="26" Padding="4,0" FontSize="10" Click="DeleteSelfButton_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
