<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Süpürücü</AssemblyName>
    <RootNamespace>ProperAppUpdater</RootNamespace>
    <Product>Süpürücü</Product>
    <ApplicationIcon>Assets\supurucu-polished.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.2.5</Version>
    <Authors>Able'r</Authors>
    <Description>Selected app updates for Windows, in Turkish and English.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="catalog.json" LogicalName="catalog.json" />
    <Resource Include="Assets\assistant-rig\*.png" />
    <Resource Include="Assets\supurucu-polished.ico" />
    <Resource Include="Assets\supurucu-polished.png" />
  </ItemGroup>

</Project>
