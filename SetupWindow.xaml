<Window x:Class="ProperAppUpdater.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Language" Icon="Assets/supurucu-polished.ico"
        Width="390" Height="220" MinWidth="390" MaxWidth="390" MinHeight="220" MaxHeight="220"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" UseLayoutRounding="True" Closing="Window_Closing">
    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            <Grid>
                <Image Source="Assets/supurucu-polished.png" Width="44" Height="44" HorizontalAlignment="Left"/>
                <Button x:Name="CancelButton" Content="×" Width="28" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="CancelButton_Click" AutomationProperties.Name="Close setup"/>
            </Grid>
            <TextBlock x:Name="QuestionText" Grid.Row="1" Margin="0,8,0,4" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <TextBlock x:Name="SubtitleText" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <StackPanel x:Name="PreparationPanel" Visibility="Collapsed">
                    <ProgressBar x:Name="PreparationProgress" Height="4" IsIndeterminate="True"/>
                    <TextBlock x:Name="PreparationText" Margin="0,5,0,0" FontSize="11" MaxHeight="42"
                               Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3" x:Name="LanguageButtons">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="TurkishButton" Content="Turkish" Click="TurkishButton_Click"/>
                <Button x:Name="EnglishButton" Content="English" Grid.Column="2" Click="EnglishButton_Click"/>
            </Grid>
            <Button x:Name="RetryButton" Grid.Row="3" Visibility="Collapsed" Click="RetryButton_Click"/>
        </Grid>
    </Border>
</Window>
